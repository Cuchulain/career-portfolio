---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholderSrc from '../assets/images/placeholder.png';

//Data Definitions
interface Social {
  name: string;
  url: string;
  icon: string;
  showInHero?: boolean;
  showInContact?: boolean;
}

interface Resume {
  label: string;
  language: string;
  format: 'PDF' | 'TXT';
  url: string;
  primary?: boolean;
  ats?: boolean;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  intro: string;
  introHtml: string;
  resumes?: Resume[];
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData; // data as ProfileData

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const { name, photoUrl, intro, introHtml, socials } = data;
const fallbackResume: Resume = {
  label: 'Senior PHP Developer',
  language: 'CZ',
  format: 'PDF',
  url: '/jan-cejka-senior-php-cv-cs.pdf',
  primary: true,
};
const resumes: Resume[] = data.resumes?.length
  ? data.resumes
  : [fallbackResume];
const primaryResume = resumes.find((resume) => resume.primary) ?? resumes[0] ?? fallbackResume;

const localPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpeg,jpg,png,webp}',
  { eager: true }
);
const resolvedPhoto: ImageMetadata | null =
  localPhotos[`../assets/images/${photoUrl}`]?.default ?? null;

const processedPlaceholder = await getImage({ src: placeholderSrc, width: 96, height: 96, format: 'jpeg' });
---

<section id="home" class="flex flex-col items-center justify-center section-container md:pt-30 gap-1 min-h-[80vh] text-center">
  <div class="relative group mb-2 reveal-content" style="animation-delay: 100ms;">
    <div class="balloon-float w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]">
      {resolvedPhoto ? (
        <Image
          src={resolvedPhoto}
          alt={name}
          class="w-full h-full object-cover scale-110"
        />
      ) : (
        <Image
          src={`/${photoUrl}`}
          width="96"
          height="96"
          alt={name}
          onerror={`this.onerror=null;this.src='${processedPlaceholder.src}';`}
          class="w-full h-full object-cover scale-110"
        />
      )}
    </div>
    <div class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"></div>
  </div>

    <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-gray leading-relaxed">
      Ahoj, já jsem
    </p>
  </div>

  <div class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content" style="animation-delay: 300ms;">
    <h1 class="mt-4 text-5xl md:text-7xl font-heading font-bold text-maintext tracking-tight">
      {name}
    </h1>
    <br>
    <p
      class="text-gray font-body text-lg leading-relaxed"
      set:html={introHtml}
    />
  </div>

  <div class="relative z-20 mt-8 mb-4 reveal-content" style="animation-delay: 400ms;">
    <div class="relative inline-flex rounded-full font-body shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] md:shadow-none">
      <a
        href={primaryResume.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex min-h-12 items-center justify-center rounded-l-full border border-r-0 border-accent/50 bg-accent/10 py-2 pl-8 pr-5 text-maintext transition-all duration-300 md:hover:bg-accent/15 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)]"
      >
        <span class="flex flex-col items-center justify-center text-center">
          <span class="text-sm font-medium tracking-wide md:text-base">
            Otevřít CV
          </span>
          <span class="whitespace-nowrap text-[10px] font-light text-subtext">
            {primaryResume.label} · {primaryResume.language}
          </span>
        </span>
      </a>

      <details data-resume-menu class="group/resume relative">
        <summary
          class="flex min-h-12 h-full w-12 cursor-pointer list-none items-center justify-center rounded-r-full border border-accent/50 bg-accent/10 text-maintext transition-all duration-300 hover:bg-accent/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden"
          aria-label="Zobrazit další varianty životopisu"
          title="Další varianty CV"
        >
          <Icon
            name="mdi:chevron-down"
            class="h-5 w-5 transition-transform duration-200 group-open/resume:rotate-180"
          />
        </summary>

        <div class="absolute right-0 top-[calc(100%+0.75rem)] z-30 w-[min(24rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-accent/30 bg-background/95 p-2 text-left shadow-[0_20px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl">
          <p class="px-3 pb-2 pt-1 text-[10px] font-medium uppercase tracking-[0.18em] text-subtext">
            Varianty životopisu
          </p>

          <div class="flex flex-col gap-1">
            {resumes.filter((resume) => !resume.ats).map((resume) => (
              <a
                href={resume.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group/item flex min-h-12 items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-accent/10 focus-visible:bg-accent/10 focus-visible:outline-none"
              >
                <Icon name="mdi:file-pdf-box" class="h-6 w-6 shrink-0 text-accent" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-medium text-maintext">{resume.label}</span>
                  <span class="block text-xs text-subtext">{resume.language} · {resume.format}</span>
                </span>
                {resume.primary && (
                  <span class="rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[10px] text-accent">
                    Doporučené
                  </span>
                )}
                <Icon name="mdi:open-in-new" class="h-4 w-4 shrink-0 text-subtext transition-colors group-hover/item:text-accent" />
              </a>
            ))}
          </div>

          {resumes.filter((resume) => resume.ats).map((resume) => (
            <div class="mt-2 border-t border-accent/20 pt-2">
              <a
                href={resume.url}
                download
                class="group/item flex min-h-12 items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-accent/10 focus-visible:bg-accent/10 focus-visible:outline-none"
              >
                <Icon name="mdi:file-document-outline" class="h-6 w-6 shrink-0 text-accent" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-medium text-maintext">{resume.label}</span>
                  <span class="block text-xs text-subtext">Pro náborové formuláře · {resume.format}</span>
                </span>
                <Icon name="mdi:download" class="h-4 w-4 shrink-0 text-subtext transition-colors group-hover/item:text-accent" />
              </a>
            </div>
          ))}
        </div>
      </details>
    </div>
  </div>

  <div class="flex gap-6 mt-4 reveal-content" style="animation-delay: 500ms;">
    {socials.filter((social) => social.showInHero && social.url && social.url !== "#" && social.url !== "").map((social) => (
      <a
        href={social.url}
        target="_blank"
        class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
      >
        <Icon
        name={social.icon}
        class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300"
      />

      <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
        {social.name}
      </span>
      </a>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-resume-menu]').forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.removeAttribute('open');
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
  });
</script>


<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* profile photo floating animation */

  /* When combined, the animation rule automatically merges these transforms */
  .avatar-container {
    animation: float 5s ease-in-out infinite alternate, wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    will-change: transform;
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      /* Moves up and slightly right */
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      /* Drifts left and stays elevated */
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      /* Returns to start */
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>
